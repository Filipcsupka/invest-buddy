{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ETF research model output: what the model returns. The runner adds run metadata and the server checks every evidence quote.",
  "type": "object",
  "additionalProperties": false,
  "required": ["asOf", "candidates"],
  "properties": {
    "asOf": { "type": "string", "format": "date" },
    "candidates": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "exchange", "name", "isin", "assetClass", "region", "call", "conviction", "thesis", "whatHappened", "whyItMatters", "plan", "risks", "cost", "price", "evidence"],
        "properties": {
          "symbol": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9.-]{0,11}$" },
          "exchange": { "type": ["string", "null"], "maxLength": 40 },
          "name": { "type": "string", "minLength": 2, "maxLength": 120 },
          "isin": { "type": ["string", "null"], "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" },
          "assetClass": { "type": "string", "enum": ["equity", "bond", "commodity", "multi_asset", "other"] },
          "region": { "type": ["string", "null"], "maxLength": 60 },
          "call": { "type": "string", "enum": ["BUY_ZONE", "WATCH", "AVOID"] },
          "conviction": { "type": "integer", "minimum": 1, "maximum": 5 },
          "thesis": { "type": "string", "maxLength": 500 },
          "whatHappened": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 300 } },
          "whyItMatters": { "type": "string", "maxLength": 500 },
          "plan": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entryZone", "addWhen", "stopAddingWhen"],
            "properties": {
              "entryZone": { "type": ["string", "null"], "maxLength": 160 },
              "addWhen": { "type": ["string", "null"], "maxLength": 240 },
              "stopAddingWhen": { "type": ["string", "null"], "maxLength": 240 }
            }
          },
          "risks": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 240 } },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": ["terPct", "aumUsdM", "trackedIndex", "domicile", "replication"],
            "properties": {
              "terPct": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
              "aumUsdM": { "type": ["number", "null"], "minimum": 0 },
              "trackedIndex": { "type": ["string", "null"], "maxLength": 120 },
              "domicile": { "type": ["string", "null"], "maxLength": 40 },
              "replication": { "type": ["string", "null"], "maxLength": 40 }
            }
          },
          "price": {
            "type": "object",
            "additionalProperties": false,
            "required": ["last", "currency", "asOf"],
            "properties": {
              "last": { "type": ["number", "null"], "exclusiveMinimum": 0 },
              "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
              "asOf": { "type": ["string", "null"], "format": "date" }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "quote", "claim"],
              "properties": {
                "url": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 500 },
                "quote": { "type": "string", "minLength": 12, "maxLength": 400 },
                "claim": { "type": "string", "enum": ["ter", "aum", "index", "domicile", "replication", "price", "holdings", "flows", "performance", "event", "other"] }
              }
            }
          }
        }
      }
    }
  }
}
