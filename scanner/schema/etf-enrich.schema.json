{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ETF catalog enrichment batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["listingKey", "isin", "issuer", "assetClass", "region", "theme", "trackedIndex", "terPct", "aumUsdM", "domicile", "replication", "distribution", "ucits", "sourceUrl"],
        "properties": {
          "listingKey": { "type": "string", "minLength": 3, "maxLength": 80 },
          "isin": { "type": ["string", "null"], "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" },
          "issuer": { "type": ["string", "null"], "maxLength": 120 },
          "assetClass": { "type": ["string", "null"], "enum": ["equity", "bond", "commodity", "multi_asset", "other", null] },
          "region": { "type": ["string", "null"], "maxLength": 80 },
          "theme": { "type": ["string", "null"], "maxLength": 120 },
          "trackedIndex": { "type": ["string", "null"], "maxLength": 160 },
          "terPct": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
          "aumUsdM": { "type": ["number", "null"], "minimum": 0 },
          "domicile": { "type": ["string", "null"], "maxLength": 60 },
          "replication": { "type": ["string", "null"], "maxLength": 80 },
          "distribution": { "type": ["string", "null"], "enum": ["acc", "dist", null] },
          "ucits": { "type": ["boolean", "null"] },
          "sourceUrl": { "type": ["string", "null"], "pattern": "^https://[^\\s]+$", "maxLength": 500 }
        }
      }
    }
  }
}
