exports[`mail templates (en) > confirm matches its snapshot 1`] = `
{
  "headers": undefined,
  "html": "<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Confirm your InvestBuddy waitlist sign-up</title></head><body style="margin:0;background:#eceeeb"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#eceeeb"><tr><td align="center" style="padding:24px 12px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:4px"><tr><td style="padding:28px"><h1 style="margin:0 0 20px;font:600 22px/1.3 Arial,Helvetica,sans-serif;color:#17201b">Confirm your InvestBuddy waitlist sign-up</h1><p style="margin:0 0 16px;font:16px/1.6 Arial,Helvetica,sans-serif;color:#17201b">You asked to join the InvestBuddy waitlist. Confirm this address to finish signing up.</p><p style="margin:0 0 16px;font:16px/1.6 Arial,Helvetica,sans-serif;color:#17201b">The link works for 7 days. If you did not sign up, ignore this mail and we will delete your address.</p><p style="margin:0 0 20px"><a href="https://invest.example.test/en/waitlist/confirm?token=abc" style="display:inline-block;padding:12px 20px;background:#17201b;color:#ffffff;text-decoration:none;border-radius:4px;font:600 16px Arial,Helvetica,sans-serif">Confirm my address</a></p><p style="margin:0 0 8px;font:13px/1.5 Arial,Helvetica,sans-serif;color:#4a5550">If the button does not work, open this link: https://invest.example.test/en/waitlist/confirm?token=abc</p><p style="margin:0 0 16px;font:16px/1.6 Arial,Helvetica,sans-serif;color:#17201b">InvestBuddy</p><hr style="border:0;border-top:1px solid #d5dad6;margin:20px 0"><p style="margin:0 0 8px;font:13px/1.5 Arial,Helvetica,sans-serif;color:#4a5550">Informational screening only. Same rules for every visitor. No personal investment advice.</p><p style="margin:0;font:13px/1.5 Arial,Helvetica,sans-serif;color:#4a5550"><a href="https://invest.example.test/en/waitlist/unsubscribe?token=7.sig" style="color:#4a5550">Unsubscribe</a></p></td></tr></table></td></tr></table></body></html>",
  "subject": "Confirm your InvestBuddy waitlist sign-up",
  "text": "Confirm your InvestBuddy waitlist sign-up

You asked to join the InvestBuddy waitlist. Confirm this address to finish signing up.

The link works for 7 days. If you did not sign up, ignore this mail and we will delete your address.

Confirm my address: https://invest.example.test/en/waitlist/confirm?token=abc

If the button does not work, open this link: https://invest.example.test/en/waitlist/confirm?token=abc

InvestBuddy

--

Informational screening only. Same rules for every visitor. No personal investment advice.

Unsubscribe: https://invest.example.test/en/waitlist/unsubscribe?token=7.sig",
}
`;

