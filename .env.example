# Fixture mode requires no credentials.
DATA_MODE=fixture
DATABASE_URL=postgresql://investbuddy:change-me@localhost:5432/investbuddy

# Feature flags (src/config/flags.ts). Values: on or off. Unset or any other value = default (off).
# IDEAS_PAGE is also always on when DATA_MODE=fixture.
#PAYWALL=off
#AUTH=off
#BILLING=off
#WAITLIST=off
#ADVICE_OUTPUT=off
#IDEAS_PAGE=off
#OWNER_VIEW=off

# Waitlist (only read when WAITLIST=on). Mail goes to the console until a provider is built.
#WAITLIST_TOKEN_SECRET=change-me-at-least-16-chars
#MAIL_PROVIDER=console
#WAITLIST_RATE_PER_MIN=5
