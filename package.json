{
  "name": "investbuddy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "ci:verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:jobs",
    "test": "vitest run src scripts && node --test scanner/test/*.test.mjs",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "migrate": "tsx scripts/migrate.ts",
    "ai-usage": "tsx scripts/ai-usage-report.ts",
    "data:inventory": "tsx scripts/data-inventory.ts",
    "research:eval": "tsx scripts/research-eval.ts",
    "daily": "tsx src/jobs/daily.ts",
    "prices": "tsx src/jobs/prices.ts",
    "reconcile": "tsx src/jobs/reconcile.ts",
    "collect": "tsx src/jobs/collect.ts",
    "collect:ping": "tsx src/jobs/collect.ts --ping",
    "detect": "tsx src/jobs/detect.ts",
    "watch": "tsx src/jobs/watch.ts",
    "discovery": "tsx src/jobs/discovery.ts",
    "discovery:promote": "tsx scripts/discovery-promote.ts",
    "retention": "tsx src/jobs/retention.ts",
    "master:refresh": "tsx src/jobs/master-refresh.ts",
    "outcomes": "tsx src/jobs/outcomes.ts",
    "macro": "tsx src/jobs/macro.ts",
    "thirteenf": "tsx src/jobs/thirteenf.ts",
    "companyfacts": "tsx src/jobs/companyfacts.ts",
    "earnings-calendar": "tsx src/jobs/earnings-calendar.ts",
    "build:jobs": "esbuild src/jobs/daily.ts src/jobs/prices.ts src/jobs/reconcile.ts src/jobs/digest.ts src/jobs/weekly.ts src/jobs/portfolio.ts src/jobs/collect.ts src/jobs/detect.ts src/jobs/watch.ts src/jobs/retention.ts src/jobs/macro.ts src/jobs/discovery.ts src/jobs/dq.ts src/jobs/backfill.ts src/jobs/companyfacts.ts src/jobs/earnings-calendar.ts src/jobs/master-refresh.ts src/jobs/thirteenf.ts src/jobs/research-verify.ts src/jobs/research-pipeline.ts src/jobs/research-notify.ts src/jobs/outcomes.ts --bundle --platform=node --format=cjs --target=node22 --packages=external --tsconfig=tsconfig.json --outdir=dist/jobs",
    "judge": "node scanner/run-judge.mjs",
    "scan:sample": "tsx scripts/post-sample-scan.ts",
    "seed:local-bars": "tsx scripts/seed-local-bars.ts",
    "backfill:track-record": "tsx scripts/backfill-track-record.ts",
    "backfill:idea-translations": "tsx scripts/backfill-idea-translations.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3"
  }
}
